# Local development only; production must supply its own credentials.
FORGE_ENVIRONMENT=local
FORGE_DATABASE_URL=postgresql+asyncpg://forge:forge_local@localhost:5432/forge
FORGE_DATABASE_TIMEOUT_SECONDS=3
# Use fake for a labelled local demo; gemini requires a real server-side key.
FORGE_MODEL_BACKEND=gemini
FORGE_GEMINI_API_KEY=
FORGE_MODEL_TIMEOUT_SECONDS=60
FORGE_MODEL_MAX_OUTPUT_TOKENS=1024
